index 0000000..7836a76
--- /dev/null
+++ b/native/linux/tests/logarchive_test.cpp
@@ -0,0 +1,125 @@
+// Offline: OPEN LOGS on Linux (src/logarchive_linux.h) against a fake install
+// ($XDG_DATA_HOME/tpf2mp with data/, plugins/, netpunch/) and a fake game
+// folder. Checks what a bug report needs is there (versions, state files, the
+// lobby's message stream), what must stay out stays out (the incoming save),
+// invitation codes are masked, state files are copied and not moved, and each
+// kind keeps TPF2_LOG_KEEP archives.
+#include "../src/logarchive_linux.h"
+#include <cassert>
+#include <cstdio>
+#include <string>
+#include <fstream>
+#include <sstream>
+
+static void put(const std::string& path, const std::string& text)
+{
+    std::ofstream f(path, std::ios::binary);
+    f << text;
+    assert(f.good());
+}
+static std::string get(const std::string& path)
+{
+    std::ifstream f(path, std::ios::binary);
+    std::stringstream ss;
+    ss << f.rdbuf();
+    return ss.str();
+}
+static bool exists(const std::string& path) { return access(path.c_str(), F_OK) == 0; }
+static int countKind(const std::string& logs, const char* kind)
+{
+    int n = 0;
+    if (DIR* d = opendir(logs.c_str())) {
+        while (dirent* e = readdir(d)) if (LaArchiveKind(e->d_name) >= 0 && strstr(e->d_name, kind)) n++;
+        closedir(d);
+    }
+    return n;
+}
+
+int main()
+{
+    char tmpl[] = "/tmp/tpf2mp-logarchive-test-XXXXXX";
+    assert(mkdtemp(tmpl));
+    const std::string t = tmpl, xdg = t + "/xdg", root = xdg + "/tpf2mp", data = root + "/data/", game = t + "/game/";
+    for (const std::string& d : { xdg, root, root + "/data", root + "/plugins", root + "/netpunch", root + "/boot",
+                                  t + "/game", game + "netpunch", t + "/home" })
+        assert(mkdir(d.c_str(), 0700) == 0);
+    setenv("XDG_DATA_HOME", xdg.c_str(), 1);
+    setenv("HOME", (t + "/home").c_str(), 1);   // no real Steam, no real crash dumps
+    unsetenv("TPF2MP_DATADIR");
+
+    // the install and its data folder
+    put(root + "/tpf2mp_install.txt", "# TpF2 Multiplayer install manifest\nversion\t0.7.0.3\ninstalled\t2026-09-26\n");
+    put(root + "/tpf2_menu.so", "ELF menu");
+    put(root + "/boot/libtpf2mp_boot.so", "ELF boot");
+    put(root + "/plugins/tpf2_bigmap.cfg", "octree_depth=13\n");
+    put(data + "tpf2_bridge.log", "[m5] bridge init\n");
+    put(data + "tpf2_bridge_ctl.txt", "instance=b\npeer=127.0.0.1:7774\nlobby=0123456789abcdef0123456789abcdef\n");
+    std::string stream(9u << 20, 'x');
+    stream.replace(0, 5, "FIRST");
+    stream.replace(stream.size() - 4, 4, "LAST");
+    put(data + "lockstep_inject_a.txt", stream);
+    // the lobby, beside the data folder
+    const std::string state = "{\"session\": \"94d4\", \"code\": \"7FVLP7EIYCUAB\\\"X\", \"players\": [\"A\"], \"mode\": \"coop\"}";
+    put(root + "/netpunch/lobby_state.json", state);
+    const std::string outLine = "{\"type\": \"code\", \"code\": \"7FVLP7EI\", \"steam\": \"76561198\", \"crossplay\": true, \"cross_code\": \"7FVLP7EI\"}\n"
+                                "{\"type\": \"roster\", \"players\": [\"A\", \"B\"]}\n";
+    put(root + "/netpunch/lobby_out.jsonl", outLine);
+    put(root + "/netpunch/lobby_proc.log", "[join] connected\n");
+    put(root + "/netpunch/incoming_save.sav", "a save");
+    put(game + "TransportFever2", "ELF game");
+
+    // six older copies: only TPF2_LOG_KEEP of that kind may remain
+    const std::string logs = root + "/logs/";
+    assert(mkdir(logs.c_str(), 0700) == 0);
+    for (int i = 0; i < 6; i++) {
+        const std::string d = logs + "2020010" + std::to_string(i) + "-000000-now";
+        assert(mkdir(d.c_str(), 0700) == 0);
+        put(d + "/about.txt", "old");
+    }
+
+    Tpf2mpLogArchive a;
+    assert(Tpf2mpArchiveLogsSafe(false, game.c_str(), &a) && a.folder[0]);
+    const std::string f = std::string(a.folder) + "/";
+    const std::string about = get(f + "about.txt");
+    printf("%s\n", about.c_str());
+
+    assert(about.find("TpF2 Multiplayer") != std::string::npos && about.find("0.7.0.3") != std::string::npos);
+    assert(about.find("Kernel") != std::string::npos && about.find("UTC") != std::string::npos);
+    assert(about.find("tpf2_menu.so") != std::string::npos && about.find("boot/libtpf2mp_boot.so") != std::string::npos);
+    assert(about.find("TransportFever2") != std::string::npos && about.find("masked") != std::string::npos);
+    // logs as before
+    assert(exists(f + "tpf2_bridge.log") && exists(f + "netpunch_lobby_proc.log"));
+    // state: copied (still in the data folder), the tail of a big stream
+    assert(get(f + "state_tpf2_bridge_ctl.txt").find("lobby=0123") != std::string::npos);
+    assert(exists(data + "tpf2_bridge_ctl.txt"));
+    const std::string tail = get(f + "state_lockstep_inject_a.txt");
+    assert(tail.size() == (8u << 20) && tail.substr(tail.size() - 4) == "LAST" && tail.find("FIRST") == std::string::npos);
+    assert(about.find("only the last 8 MB kept") != std::string::npos);
+    // the install manifest and the plugin configuration
+    assert(get(f + "tpf2mp_install.txt").find("version\t0.7.0.3") != std::string::npos);
+    assert(exists(f + "plugins_tpf2_bigmap.cfg"));
+    // never the save
+    assert(!exists(f + "netpunch_incoming_save.sav"));
+    // the lobby's files: codes masked, same length, everything else intact
+    const std::string st = get(f + "netpunch_lobby_state.json");
+    assert(st.size() == state.size() && st.find("7FVLP7") == std::string::npos);
+    assert(st.find("\"code\": \"****************\"") != std::string::npos && st.find("\"mode\": \"coop\"") != std::string::npos);
+    const std::string ol = get(f + "netpunch_lobby_out.jsonl");
+    assert(ol.size() == outLine.size() && ol.find("7FVLP7") == std::string::npos && ol.find("76561198") == std::string::npos);
+    assert(ol.find("\"type\": \"code\"") != std::string::npos && ol.find("\"crossplay\": true") != std::string::npos);
+    assert(ol.find("\"players\": [\"A\", \"B\"]") != std::string::npos);
+    assert(get(root + "/netpunch/lobby_state.json") == state);   // the original is untouched
+    // retention: the five newest copies, this one included
+    assert(countKind(logs, "-now") == TPF2_LOG_KEEP);
+
+    // a start-of-run archive moves the logs but only copies the state
+    put(data + "tpf2_slice.log", "[slice] up\n");
+    Tpf2mpLogArchive b;
+    assert(Tpf2mpArchiveLogsSafe(true, game.c_str(), &b) && b.folder[0]);
+    assert(!exists(data + "tpf2_slice.log") && exists(std::string(b.folder) + "/tpf2_slice.log"));
+    assert(exists(data + "tpf2_bridge_ctl.txt") && exists(std::string(b.folder) + "/state_tpf2_bridge_ctl.txt"));
+
+    printf("PASS: versions, state files (copied, 8 MB tail), install manifest and plugin cfg, lobby stream with codes masked, "
+           "no save, keep %d\n", TPF2_LOG_KEEP);
+    return 0;
+}
