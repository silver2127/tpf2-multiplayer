+        if (name < base || name >= base + hi || strncmp(reinterpret_cast<const char*>(name), "N3ecs", 5) ||
+            !strstr(reinterpret_cast<const char*>(name), "Family") || !strcmp(reinterpret_cast<const char*>(name), "N3ecs7IFamilyE"))
