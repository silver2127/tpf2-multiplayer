#!/bin/sh
# tpf2server -- operate the dedicated server (installed by setup_vps.sh to /usr/local/bin).
#
#   tpf2server status              units, the game process, the lobby's code and roster
#   tpf2server install             the mod: install_proton.sh from the GitHub release into the client's game
#   tpf2server configure           write tpf2_menu_flags.txt (dedicated mode) and a headless settings.lua from /etc/tpf2mp/server.env
#   tpf2server start|stop|restart  the game (the Steam client stays up)
#   tpf2server logs [n]            the last n lines of the mod's menu log
#   tpf2server say <text>          a chat line from the server
#   tpf2server code                the join code
#
# Run as root (systemctl) or as tpf2server (files).
set -eu
ENV=${TPF2_SERVER_ENV:-/etc/tpf2mp/server.env}
[ -f "$ENV" ] && . "$ENV"
: "${DISPLAY:=:9}" "${LOBBY_PORT:=29472}" "${LOBBY_NAME:=Dedicated Server}" "${SERVER_NAME:=Server}" "${LOBBY_PASSWORD:=}"
: "${COMPANIES:=1}" "${SAVE:=}" "${AUTOSAVE_MIN:=10}" "${EMPTY_SPEED:=1}" "${RENDER:=0}" "${FPS:=30}" "${MOD_RELEASE:=}" "${MASTER_URL:=}"
# the older setting: PAUSE_EMPTY=1 is EMPTY_SPEED=0
[ "${PAUSE_EMPTY:-}" = 1 ] && EMPTY_SPEED=0
: "${STEAM_ROOT:=/home/tpf2server/.steam/steam}"
: "${GAME_DIR:=$STEAM_ROOT/steamapps/common/Transport Fever 2}"
NETDIR="$GAME_DIR/netpunch"
: "${RUNTIME:=proton}" "${XDG_DATA_HOME:=/home/tpf2server/.local/share}"
case "$RUNTIME" in
native) MODDIR="$XDG_DATA_HOME/tpf2mp"; NETDIR="$MODDIR/netpunch"; MENU_LOG="$MODDIR/data/tpf2_menu.log" ;;
proton) MODDIR="$GAME_DIR"; MENU_LOG="$GAME_DIR/tpf2_menu.log" ;;
*) echo "RUNTIME must be native or proton" >&2; exit 2 ;;
esac
as_server() { if [ "$(id -un)" = tpf2server ]; then "$@"; else sudo -u tpf2server "$@"; fi; }

cmd=${1:-status}; shift || true
case "$cmd" in
status)
    for u in tpf2mp-xvfb tpf2mp-steam tpf2mp-game; do printf '%-14s %s\n' "$u" "$(systemctl is-active $u 2>/dev/null || echo unknown)"; done
    if [ "$RUNTIME" = native ]; then pattern='(^|/)TransportFever2($| )'; else pattern='TransportFever2[.]exe'; fi
    game_pid=$(pgrep -u tpf2server -f "$pattern" | head -1 || true)
    if [ -n "$game_pid" ]; then echo "game: running ($RUNTIME, pid $game_pid)"; else echo "game: not running ($RUNTIME)"; fi
    [ -f "$NETDIR/lobby_proc.log" ] && grep -a "^CODE=\|\[host\] JOIN\|\[host\] LEAVE\|DROP\|listed publicly" "$NETDIR/lobby_proc.log" | tail -6
    if [ -f "$MENU_LOG" ]; then grep -a "\[dedicated\]" "$MENU_LOG" | tail -4; fi
    ;;
install)
    if [ "$RUNTIME" = native ]; then
        : "${NATIVE_RELEASE_DIR:?Set NATIVE_RELEASE_DIR to an unpacked Linux mod release}"
        as_server bash "$NATIVE_RELEASE_DIR/install.sh" --game "$GAME_DIR" --data-home "$XDG_DATA_HOME" "$@"
        echo "installed; now: tpf2server configure"
        exit 0
    fi
    # the release's installer: it finds Steam, the game and the Proton prefix by itself
    url="https://github.com/silver2127/tpf2-multiplayer/releases/${MOD_RELEASE:+download/v$MOD_RELEASE}${MOD_RELEASE:-latest/download}/install_proton.sh"
    tmp=$(mktemp -d); chmod 755 "$tmp"          # readable by the tpf2server user the installer runs as
    curl -fsSL "$url" -o "$tmp/install_proton.sh"; chmod 644 "$tmp/install_proton.sh"
    as_server bash "$tmp/install_proton.sh" --steam-root "$STEAM_ROOT" "$@"   # a bash script (arrays); sh is dash here
    rm -rf "$tmp"
    echo "installed; now: tpf2server configure"
    ;;
configure)
    [ -d "$GAME_DIR" ] || { echo "game dir not found: $GAME_DIR (install the game in the Steam client first)"; exit 1; }
    flags="$MODDIR/tpf2_menu_flags.txt"
    as_server sh -c 'cat > "$1"' sh "$flags" <<EOF
dedicated=1
dedicated_save=$SAVE
dedicated_lobby=$LOBBY_NAME
dedicated_name=$SERVER_NAME
dedicated_password=$LOBBY_PASSWORD
dedicated_public=1
dedicated_companies=$COMPANIES
dedicated_autosave_min=$AUTOSAVE_MIN
dedicated_empty_speed=$EMPTY_SPEED
dedicated_render=$RENDER
dedicated_fps=$FPS
dedicated_port=$LOBBY_PORT
autoload=1
${MASTER_URL:+master_url=$MASTER_URL}
EOF
    echo "wrote $flags"
    # a headless-sized settings.lua: the smallest window, the lowest graphics, no sound.
    # The game writes the file on its first run; only then are the keys there to change.
    for s in "$STEAM_ROOT"/userdata/*/1066780/local/settings.lua; do
        [ -f "$s" ] || continue
        as_server python3 - "$s" <<'EOF'
import re, sys
p = sys.argv[1]
t = open(p, encoding="utf-8").read()
want = {"fullscreen": "false", "screenMode": '"BORDERLESS"', "windowSize": "{ 640, 480, }",
        "vsync": "false", "resolutionScale": "0.5", "viewportScale": "1",
        "shadowQuality": "0", "textureQuality": "0", "numSamples": "0", "anisotropicFiltering": "0", "maxDegreeOfAnisotropy": "1",
        "geometryQuality": "0", "grassQuality": "0", "bloomQuality": "0", "terrainTextureQuality": "0",
        "terrainTesselationEnabled": "false", "useSsao": "false", "useReflection": "false", "useHdr": "false",
        "terrainTriplanarDistance": "0",
        "masterVolume": "0", "musicVolume": "0", "soundVolume": "0", "musicEnabled": "false", "menuMusicEnabled": "false",
        # the news popup ("DO NOT SHOW AGAIN") keeps the title page from being built until it is
        # dismissed, and the choice is written only on a clean exit -- which a server never has.
        # 7 is the Autumn 2026 update's id; the game shows the popup again for a higher one.
        "updateMessageID": "7"}
for k, v in want.items():
    t, n = re.subn(r"(?m)^(\s*%s\s*=\s*).*?,\s*$" % re.escape(k), lambda m: m.group(1) + v + ",", t)
open(p, "w", encoding="utf-8").write(t)
print("settings:", p)
EOF
    done
    ;;
start)   systemctl start tpf2mp-game ;;
stop)    systemctl stop tpf2mp-game; [ "$RUNTIME" = native ] || pkill -9 -u tpf2server -f "^[A-Za-z]:.*TransportFever2[.]exe" 2>/dev/null || true ;;
restart) systemctl stop tpf2mp-game; if [ "$RUNTIME" = proton ]; then pkill -9 -u tpf2server -f "^[A-Za-z]:.*TransportFever2[.]exe" 2>/dev/null || true; fi; systemctl start tpf2mp-game ;;
logs)    tail -n "${1:-40}" "$MENU_LOG" ;;
code)    grep -a "^CODE=" "$NETDIR/lobby_proc.log" | tail -1 ;;
say)
    [ $# -gt 0 ] || { echo "usage: tpf2server say <text>"; exit 2; }
    text=$(printf '%s' "$*" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')
    printf '{"cmd":"chat","text":%s}\n' "$text" | as_server sh -c 'cat >> "$1"' sh "$NETDIR/lobby_in.jsonl"
    ;;
*) sed -n 2,12p "$0"; exit 2 ;;
esac
