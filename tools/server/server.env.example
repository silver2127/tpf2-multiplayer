# /etc/tpf2mp/server.env -- the dedicated server's settings (systemd EnvironmentFile,
# read by tpf2mp-steam, tpf2mp-game and the tpf2server command). Written by
# setup_vps.sh from this example when absent; edit and `tpf2server configure`.
DISPLAY=:9
# the lobby's UDP+TCP port. NOT 29471 on a box that also runs the dedicated relay.
LOBBY_PORT=29472
# what players see in PUBLIC GAMES, and the server's player name in the roster
LOBBY_NAME="Dedicated Server"
SERVER_NAME="Server"
# empty = open
LOBBY_PASSWORD=
# 1: each player their own company (SEPARATE COMPANIES); 0: everyone in company 1
COMPANIES=1
# the save NAME (without .sav) the server loads; empty = the newest save in its save folder
SAVE=
# the game's own autosave, minutes; 0 = never. A restart loads the newest save.
AUTOSAVE_MIN=10
# 1: the world pauses while nobody else is in
PAUSE_EMPTY=1
# the Steam library and the game, as the client installed them (tpf2server install prints them)
STEAM_ROOT=/home/tpf2server/.steam/steam
GAME_DIR="/home/tpf2server/.steam/steam/steamapps/common/Transport Fever 2"
# the release whose install_proton.sh installs the mod (tpf2server install); empty = latest
MOD_RELEASE=
