# /etc/tpf2mp/server.env -- the dedicated server's settings (systemd EnvironmentFile,
# read by tpf2mp-steam, tpf2mp-game and the tpf2server command). Written by
# setup_vps.sh from this example when absent; edit and `tpf2server configure`.
DISPLAY=:9
# native: Linux executable with the native mod installed; proton: Windows game.
RUNTIME=proton
# Native mod installation and writable state (must match install.sh --data-home).
XDG_DATA_HOME=/home/tpf2server/.local/share
# For native `tpf2server install`, an unpacked Linux mod release folder.
NATIVE_RELEASE_DIR=
# the lobby's UDP+TCP port. NOT 29471 on a box that also runs the dedicated relay.
LOBBY_PORT=29472
# what players see in PUBLIC GAMES, and the server's player name in the roster
LOBBY_NAME="Dedicated Server"
SERVER_NAME="Server"
# empty = open
LOBBY_PASSWORD=
# 1: each player their own company (SEPARATE COMPANIES); 0: everyone in company 1
COMPANIES=1
# the save NAME (without .sav) the server loads; empty = the newest save in its save folder
SAVE=
# the game's own autosave, minutes; 0 = never. A restart loads the newest save.
AUTOSAVE_MIN=10
# the world's speed while nobody else is in: 1..4, or 0 = paused (PAUSE_EMPTY=1 is the older spelling of 0)
EMPTY_SPEED=1
# 0: the game submits no rendering work (a software renderer then costs nothing; xclick.sh shots are black);
# 1: it draws, for a look at the window
RENDER=0
# headless frames a second (5-240): the engine needs 5 batches a second; more is scene prep for nobody
FPS=30
# Native startup grace after the title menu. Tested VPS setting: 15 seconds;
# retain 45 for installations that still initialize resources after the menu.
LOAD_DELAY_SEC=45
# the Steam library and the game, as the client installed them (tpf2server install prints them)
STEAM_ROOT=/home/tpf2server/.steam/steam
GAME_DIR="/home/tpf2server/.steam/steam/steamapps/common/Transport Fever 2"
# the release whose install_proton.sh installs the mod (tpf2server install); empty = latest
MOD_RELEASE=
# the public game list. On the box that runs the master server itself, its local address
# (the public hostname is not reachable from inside Wine there); empty = the release default
MASTER_URL=http://127.0.0.1:8471
